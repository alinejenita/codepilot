OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m

WORKSPACE_ROOT=./workspace
MAX_AGENT_ITERATIONS=8
COMMAND_TIMEOUT_SECONDS=30

# Browser login: password must be 12+ characters; session secret must be 32+.
# Use secure cookies for HTTPS, and never commit these values.
CODEPILOT_LOGIN_USERNAME=
CODEPILOT_LOGIN_PASSWORD=
CODEPILOT_SESSION_SECRET=
CODEPILOT_COOKIE_SECURE=false
